+# [STAGE2-PATCH] append a per-model / per-trajectory PyRosetta relaxation failure
+# record as JSONL in the BindCraft design_path root (persistent storage)
+def record_stage2_relax_failure(design_root, record):
+    os.makedirs(design_root, exist_ok=True)
+    log_path = os.path.join(design_root, "relax_failures.jsonl")
+    with open(log_path, 'a') as f:
+        f.write(json.dumps(record, sort_keys=True) + "\n")
+    return log_path
+
